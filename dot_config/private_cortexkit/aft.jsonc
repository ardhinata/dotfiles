{
  "$schema": "https://raw.githubusercontent.com/cortexkit/aft/main/assets/aft.schema.json",

  "disabled_tools": ["aft_delete", "aft_move"],

  "indexes": {
    "trigram": true,
    "semantic": true,
    "callgraph": true,
  },

  // Correct as-is: top-level `bash` is the current form; `experimental.bash.*`
  // is the legacy spelling still accepted for back-compat. All three flags
  // default to false, so these are genuinely on.
  "bash": {
    "compress": true,
    "rewrite": true,
    "background": true,
    // long_running_reminder_enabled: true,      // already the default
    // long_running_reminder_interval_ms: 600000, // already the default
  },

  "github": {
    "read": true,
    "write": false,
  },

  // AFT runs the language servers itself. It installs the npm ones into its
  // own cache, so no manual install is needed. `diagnostics_on_edit` makes
  // every write, edit, and patch wait for the language server and return
  // fresh diagnostics with the result. The default is false, so diagnostics
  // arrive only when the agent asks for them.
  "lsp": {
    "diagnostics_on_edit": true
  },

  "semantic": {
    "backend": "openai_compatible",
    "model": "qwen/qwen3-embedding-8b",
    // The local proxy adds "dimensions" to every request, so the model
    // returns the width the path names instead of 4096. AFT sends no
    // dimensions field of its own. The proxy forwards the Authorization
    // header, so the API key stays in the environment and never reaches a
    // file.
    // The a91e786a61cc segment is an identity salt. The proxy drops it before
    // the call reaches the provider, but AFT hashes the base_url into the
    // index fingerprint, so changing the salt forces a rebuild of every root.
    // The 384 segment names the vector width. The proxy serves 384 floats to
    // this caller. AFT also hashes the width it observes into the
    // fingerprint, so the width and the identity change together and the
    // index rebuilds at the new width. An A/B on 2026-10-31 found 384 and
    // 512 equal on every retrieval metric over 62 queries, and 384 cuts the
    // index by 18.8 percent. The magic-context lane keeps 512, because it
    // has no lexical lane to fall back on.
    // The proxy script must be updated and restarted before this URL takes
    // effect. An older proxy ignores the width segment and serves 512.
    "base_url": "http://127.0.0.1:8099/a91e786a61cc/384/v1",
    "api_key_env": "OPENROUTER_API_OPENCODE_INDEX",

    // --- changed from 3000 (schema default) ---
    // Measured OpenRouter round-trip for this model: 1.1-2.0 s for a short
    // query, 1.1-1.6 s for a 1539-token row. A query embed that blows this
    // deadline does NOT raise — aft_search quietly falls back to the lexical
    // lane, which reads as "semantic search is just bad."
    "query_timeout_ms": 8000,

    // Made explicit. "auto" applies the documented recipe for the model
    // family. qwen3-embedding-8b is in that family, so queries carry the
    // model-card retrieval instruction and stored rows stay bare. Same
    // instruction as the magic-context lane.
    "query_instruction": "auto",

    // --- both OPTIONAL, and both force a full re-embed of every root ---
    // qwen3-embedding-8b takes 32768-40960 context; omitting this keeps the
    // MiniLM-era 512-token chunk caps. Raise for finer-grained indexing; pay
    // in tokens + rebuild.
    // 640 was the measured sweet spot (A/B on 2026-10-28): it cut the embedded
    // text by 19.7 percent with no measurable recall loss. Now 480, shrinking
    // the token cap to reduce context dilution.
    // The rebuild time does not depend on this cap. Two erenmin rebuilds of
    // the same 21297 chunks took 1490 s at 640 tokens per row and 1457 s at
    // 480. The cap changes the text length of a chunk, not the chunk count,
    // and 25 percent less text per chunk bought no speed, so tokens per
    // minute is not the binding constraint here. Changing this cap costs a
    // full re-embed of every root and buys no speed.
    "max_input_tokens": 480,
    //
    // Default 20000 is a local-fastembed memory guard. Remote backends embed
    // server-side, so this only bites on roots over 20k files.
    // "max_files": 50000,

    // "timeout_ms": 25000,      // schema default; fine for background builds
    // "max_batch_size": undefined, // let the pipeline size its own batches
    // Measured 2026-10-26: the upstream provider (Nebius Token Factory)
    // enforces a tokens-per-minute quota and answers a burst with HTTP 429.
    // AFT shrinks the batch on a timeout, but a 429 keeps the batch size, so
    // one big request can fail on its own and burn three retries. The
    // provider quota, not the batch size, is the wall on throughput.
    // 32 rows keeps one request near 15k tokens, inside the request size that
    // measured free of HTTP 429. At 80 rows the same rebuild sent 38k tokens
    // per request and hit the 25 s build deadline once, plus 6 upstream
    // HTTP 502 resets. Both sizes ran at the same 14 chunks per second, so
    // the smaller batch costs no time. This cap is not fingerprinted, so
    // changing it needs no re-embed.
    "max_batch_size": 32,
  },
}

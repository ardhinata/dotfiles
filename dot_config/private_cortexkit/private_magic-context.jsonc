{
  "$schema": "https://raw.githubusercontent.com/cortexkit/magic-context/master/assets/magic-context.schema.json",
  "historian": {
    "opencode": {
      "model": {
        "model": "openrouter/minimax/minimax-m3.1-flash",
        "variant": "low",
      },
      "fallback_models": [
        { "model": "openrouter/openai/gpt-6-luna", "variant": "low" },
        { "model": "opencode-go/glm-5.3-flash", "variant": "low" },
      ],
    },
    "two_pass": true,
  },
  "dreamer": {
    // All daily tasks share the 03:00 slot. A missed slot stays due and the
    // dreamer catches it up on the next session, so one hour means one
    // background chain per session instead of one chain per hour.
    "tasks": {
      "map-memories":         { "schedule": "0 3 * * *" },
      // Every 2 days. The gate for verify does not self limit, so a daily slot
      // runs a tool loop every night while the project holds memories.
      "verify":               { "schedule": "0 3 */2 * *" },
      "verify-broad":         { "schedule": "0 3 * * 0" },
      "curate":               { "schedule": "0 3 * * 0" },
      "classify-memories":    { "schedule": "0 3 * * *" },
      "compress-cues":        { "schedule": "0 3 * * *" },
      "retrospective":         { "schedule": "0 3 * * *" },
      "evaluate-smart-notes": { "schedule": "0 3 * * *" },
      "review-user-memories": { "schedule": "0 3 * * *" },
      "promote-primers":      { "schedule": "0 3 * * *" },
      "refresh-primers":      { "schedule": "0 3 * * *" }
    },
    "opencode": {
      "model": {
        "model": "openrouter/minimax/minimax-m3.1-flash",
        "variant": "high",
      },
      "fallback_models": [
        { "model": "openrouter/openai/gpt-6-luna", "variant": "high" },
        { "model": "opencode-go/glm-5.3-flash", "variant": "high" },
      ],
    },
  },
  "language": "en",
  "prompt_surface": {
    "default": "full",
  },
  "memory": {
    "enabled": true,
    "injection_budget_tokens": 6000,
    "auto_promote": true,
    "retrieval_count_promotion_threshold": 3,
    "auto_search": {
      "enabled": true,
      "score_threshold": 0.6,
      "min_prompt_chars": 20,
    },
    "git_commit_indexing": {
      "enabled": true,
      "since_days": 720,
      "max_commits": 2000,
    },
  },
  "sqlite": {
    "cache_size_mb": 128,
    "mmap_size_mb": 0,
  },
  "embedding": {
    "provider": "openai-compatible",
    "model": "qwen/qwen3-embedding-8b",
    // The local proxy adds "dimensions" to every request, so the model
    // returns 512 floats instead of 4096. The plugin sends no dimensions
    // field of its own. The proxy forwards the Authorization header, so the
    // API key stays in the environment and never reaches a file.
    "endpoint": "http://127.0.0.1:8099/v1",
    "api_key": "{env:OPENROUTER_API_OPENCODE_INDEX}",
    // Same 640 cap as the AFT lane (A/B on 2026-10-28): 19.7 percent fewer
    // embedded characters, no measurable recall loss.
    "max_input_tokens": 640,
  },
  "caveman_text_compression": {
    "enabled": true,
    "min_chars": 500,
  },
}

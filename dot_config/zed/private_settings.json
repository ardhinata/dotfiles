// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "proxy": "",
  "project_panel": {
    "hide_root": true
  },
  "title_bar": {
    "show_branch_status_icon": false
  },
  "inlay_hints": {
    "show_background": true,
    "enabled": true
  },
  "show_signature_help_after_edits": true,
  "diff_view_style": "unified",
  "which_key": {
    "enabled": true
  },
  "markdown_preview": {
    "heading_font_weight": 700.0,
    "font_family": "NotoSans Nerd Font"
  },
  "ui_font_family": "NotoSans Nerd Font",
  "buffer_line_height": "standard",
  "buffer_font_family": "RobotoMono Nerd Font",
  "terminal": {
    "toolbar": {
      "breadcrumbs": true
    },
    "bell": "off",
    "copy_on_select": true,
    "font_weight": 400.0,
    "font_size": 13.0,
    "font_family": "Terminess Nerd Font"
  },
  "reveal_if_open": true,
  "cli_default_open_behavior": "new_window",
  "colorize_brackets": true,
  "indent_guides": {
    "background_coloring": "indent_aware",
    "coloring": "indent_aware"
  },
  "soft_wrap_indent": "none",
  "soft_wrap": "editor_width",
  "restore_on_startup": "launchpad",
  "icon_theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha"
  },
  "agent": {
    "max_idle_retained_threads": 3,
    "show_turn_stats": true,
    "thinking_display": "always_expanded",
    "terminal_init_command": "opencode",
    "play_sound_when_agent_done": "always",
    "favorite_models": [],
    "model_parameters": [],
    "auto_compact": {
      "enabled": false
    }
  },
  "agent_servers": {
    "OpenCode ACP": {
      "default_config_options": {
        "model": "openrouter/minimax/minimax-m3.1-flash"
      },
      "type": "custom",
      "command": "opencode",
      "args": [
        "acp"
      ]
    }
  },
  "edit_predictions": {
    "mode": "subtle",
    "codestral": {
      "prediction_debounce": 400,
      "max_tokens": 64
    },
    "provider": "mercury",
    "mercury": {
      "prediction_debounce": 400
    }
  },
  "semantic_tokens": "combined",
  "minimap": {
    "show": "never"
  },
  "auto_signature_help": true,
  "redact_private_values": true,
  "base_keymap": "Zed",
  "ui_font_size": 14.0,
  "buffer_font_size": 12.0,
  "theme": {
    "mode": "system",
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "wrap_guides": [64,80,120]
}

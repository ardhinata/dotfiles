{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "session": {
    "thinking": "show",
    "grouping": "auto",
    "verbosity": "medium",
    "image_preview": false,
    "sidebar": "auto",
    "markdown": "rendered",
    "permissions": "prompt"
  },
  "diffs": {
    "single": true,
    "view": "unified",
    "wrap": "word"
  },
  "scroll": {
    "acceleration": true
  },
  "debug": {
    "devtools": true,
    "turn_tokens": true
  },
  "theme": {
    "name": "opencode2"
  },
  "experimental": {
    "new-designs": true,
    "client-mcp": true
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.5
  },
  "terminal": {
    "copy": "select"
  }
}

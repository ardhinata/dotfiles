{{- $host := fromYaml (includeTemplate "host.yaml.tmpl" .) -}}
{
  "$schema": "https://opencode.ai/v2/cli.json",
  "animations": true,
  "session": {
    "thinking": "show",
    "grouping": "auto",
    "verbosity": "medium"{{ if $host.opencode_cli_extra }},
    "image_preview": false,
    "sidebar": "auto",
    "markdown": "rendered",
    "permissions": "prompt"{{ end }}
  },
  "diffs": {
    "single": true,
    "view": "unified"{{ if $host.opencode_cli_extra }},
    "wrap": "word"{{ end }}
  },
  "scroll": {
    "acceleration": true
  },
  "debug": {
    "devtools": true,
    "turn_tokens": true
  },
  "theme": {
    "name": "opencode2"
  },
  "experimental": {
    "new-designs": true,
    "client-mcp": true
  },
  "tabs": {
    "mode": "auto",
    "layout": "horizontal"
  },
  "attention": {
    "notifications": true,
    "sound": true,
    "volume": 0.5
  },
  "terminal": {
    "copy": "select"
  }
}

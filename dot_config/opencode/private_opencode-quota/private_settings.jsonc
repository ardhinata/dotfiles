// OpenCode Quota settings: only the ones you changed. A missing key uses its default.
// Every setting and its default: https://github.com/slkiser/opencode-quota/blob/main/docs/readme/configuration.md
// Edit it by hand or ask your agent; OpenCode Quota keeps your comments when it saves.
{
  "version": 6,
  "layout": {
    "bar": "line"
  },
  "words": {
    "percent": "left",
    "reset": "smart",
    "sessionTokens": "tree"
  },
  "collapsed": {
    "hidden": [
      "openrouter",
      "opencode"
    ]
  },
  "sidebar": {
    "hidden": [
      "opencode"
    ]
  },
  "statusLine": {
    "hidden": [
      "opencode"
    ]
  },
  "toast": {
    "hidden": [
      "opencode"
    ]
  },
  "providers": {
    "checking": {
      "minIntervalMs": 600000
    }
  }
}

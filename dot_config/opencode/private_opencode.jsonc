{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/usr/bin/bash",
  "username": "ardhinata",
  "plugins": [
    "cc-safety-net@latest",
    "opencode-handoff@latest",
    "@cortexkit/opencode-magic-context@latest",
    "@cortexkit/aft-opencode@0.62.0",
    "-opencode.tool.shell",
    "-opencode.tool.patch",
    "@dietrichgebert/ponytail",
    "@hueyexe/opencode-ensemble@latest"
  ],
  "instructions": [
    "~/.agents/rules/*.md",
    "~/.agents/rules.personal.d/*.md"
  ],
  "permissions": [
    { "action": "external_directory", "resource": "~/.local/share/opencode/worktree/**", "effect": "allow" },
    // These two skills document tools that do not exist on this host.
    // tavily-defaults describes five Tavily MCP tools and no MCP server is
    // configured. spec-kit describes a tool that was removed on 2026-10-24.
    // The deny hides them from the model without deleting the files.
    { "action": "skill", "resource": "tavily-defaults", "effect": "deny" },
    { "action": "skill", "resource": "spec-kit", "effect": "deny" }
  ],
  "snapshots": true,
  "watcher": {
    "ignore": [
      ".git/**",
      "node_modules/**"
    ]
  },
  "formatter": true,
  // Effort is pinned to `high`. The model defaults to `max`, which costs 48x
  // the reasoning tokens and 12x the wall clock in one measurement, and 7.7x
  // and 3.7x in another, for no measured quality gain. `high` is the middle
  // rung. Change the suffix to `low`, `medium`, `high`, `xhigh`, or `max`.
  "model": "openrouter/minimax/minimax-m3.1-flash#high",
  "agents": {
    "title": {
      // Title generation needs no reasoning. The model exposes a toggle rather
      // than an effort ladder, so `#none` is the low rung. It is the cheapest
      // valid variant. `#high` and `#max` also exist.
      "model": "openrouter/qwen/qwen3.7-flash#none"
    }
  },
  // Tavily is the only websearch provider with a keyless fallback, so the tool
  // still works when TAVILY_API_KEY is absent. "random" also picks exa and
  // firecrawl, which fail with HTTP 401 when their key is missing.
  "websearch": {
    "provider": "tavily",
  },
  "providers": {
    // Openrouter-specific provider settings to pin the inference provider to cheapest available
    "openrouter": {
      "package": "@opencode/ai/providers/openrouter",
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "settings": {
            "provider": {
              "only": [
                "decart/fp4",
                "inference-net/fp8",
                "sail-research/fp4",
                "deepinfra/fp8",
                "relace"
              ]
            }
          }
        },
        "minimax/minimax-m3": {
          "settings": {
            "provider": {
              "only": [
                "minimax"
              ]
            }
          }
        },
        "minimax/minimax-m3.1-flash": {
          "settings": {
            "provider": {
              "only": [
                "minimax"
              ]
            }
          }
        },
        "z-ai/glm-5.3": {
          "settings": {
            "provider": {
              "only": [
                "wafer/us",
                "wafer/fp4",
                "sail-research/fp8",
                "relace",
                "siliconflow/fp8",
                "novita/fp8",
                "inference-net/fp4"
              ]
            }
          }
        },
        "z-ai/glm-5.3-flash": {
          "settings": {
            "provider": {
              "only": [
                "open-inference/fp4",
                "streamlake/fp8",
                "novita/fp8",
                "relace",
                "sail-research/fp4",
                "gmicloud/fp8",

              ]
            }
          }
        },
        "xiaomi/mimo-v2.6-flash": {
          "settings": {
            "provider": {
              "only": [
                "makora/fp8",
                "novita/fp8",
                "xiaomi/fp8"
              ]
            }
          }
        }
      }
    }
  },
  "compaction": {
    "auto": false
  }
}

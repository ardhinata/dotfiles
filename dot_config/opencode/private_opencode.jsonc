{
  "$schema": "https://opencode.ai/config.json",
  "shell": "bash",
  "username": "ardhinata",
  "plugins": [
    "@slkiser/opencode-quota@latest",
    "cc-safety-net@latest",
    "@cortexkit/aft-opencode@latest",
    "@cortexkit/opencode-magic-context@latest",
    "opencode-handoff@latest",
    "@dietrichgebert/ponytail@latest",
    "opencode-orchestrator@latest",
    "-opencode.tool.shell",
    "-opencode.tool.patch",
  ],
  "instructions": [
    "~/.agents/rules/*.md",
    "~/.agents/rules.personal.d/*.md",
    "~/.agents/rules.opencode/*.md",
    "~/.config/opencode/rules/*.md",
  ],
  // The context7 MCP server serves the current documentation of open-source
  // apps, services, and frameworks. It stays disabled by default, because a
  // connected server adds its tool schemas to every request. Set `disabled`
  // to false when a task clearly benefits from it. The `context7` section in
  // ~/.agents/rules.opencode/web-verification.md tells the agent to check
  // this server first.
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp",
        "disabled": true,
      },
    },
  },
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.local/share/opencode/worktree/**",
      "effect": "allow",
    },

    // Destructive shell commands. The action token is `shell`, not `bash`. A
    // `bash` rule validates against the schema and blocks nothing.
    //
    // Only `rm` belongs here. cc-safety-net already blocks `git reset
    // --hard`, `git clean -fd`, `git push --force`, `git push -f`, `rm -rf /`,
    // and `rm -rf ~`. One owner per command class.
    //
    // Only the catastrophic paths stay here: the filesystem root and the
    // home directory. Both are blocked by cc-safety-net as well, so these
    // rules are the backup for a disabled plugin.
    //
    // Every other recursive delete is left to cc-safety-net
    // (`rm.recursive-force-outside-cwd`) and to the personal
    // `destructive-actions.md` rule. A path outside the working directory
    // needs the user's approval. A path inside it does not. The temporary
    // roots `/tmp` and `/var/tmp` count as scratch space.
    //
    // The patterns are path-anchored on purpose. The shell scanner pulls
    // words out of quoted strings, so a looser `*rm -*rf*` also denies any
    // command whose text merely mentions `rm -rf`, such as a commit message
    // that documents this rule.
    //
    // A bare relative name (`rm -rf build`) is not caught here. It is not
    // distinguishable from quoted text, so the `destructive-actions.md` rule
    // covers it.
    { "action": "shell", "resource": "rm -*rf /", "effect": "deny" },
    { "action": "shell", "resource": "rm -*rf ~*", "effect": "deny" },
    { "action": "shell", "resource": "rm -*fr /", "effect": "deny" },
    { "action": "shell", "resource": "rm -*fr ~*", "effect": "deny" },
  ],
  "snapshots": true,
  "watcher": {
    "ignore": [".git/**", "node_modules/**"],
  },
  "formatter": true,
  // Effort is pinned to `high`. The model defaults to `max`, which costs 48x
  // the reasoning tokens and 12x the wall clock in one measurement, and 7.7x
  // and 3.7x in another, for no measured quality gain. `high` is the middle
  // rung. Change the suffix to `low`, `medium`, `high`, `xhigh`, or `max`.
  "model": "openrouter/minimax/minimax-m3.1-flash#high",
  "agents": {
    "title": {
      // Title generation needs no reasoning. The model exposes a toggle rather
      // than an effort ladder, so `#none` is the low rung. It is the cheapest
      // valid variant. `#high` and `#max` also exist.
      "model": "openrouter/qwen/qwen3.7-flash#none",
    },
  },
  // Keep the session's prompt cache alive across short pauses. `duration` is
  // measured from the last real model request, not from the last ping. With
  // the default 4-minute interval, a 16-minute window pings at minutes 4, 8
  // and 12; the ping at 12 keeps the provider cache warm for its own TTL
  // after the window closes. Omitted fields keep their defaults, and the
  // interval must stay shorter than the duration.
  "warming": {
    "duration": "16 minutes",
  },
  "providers": {
    // Openrouter-specific provider settings to pin the inference provider to cheapest available
    "openrouter": {
      "package": "@opencode/ai/providers/openrouter",
      "models": {
        "deepseek/deepseek-v4.1-flash-1017": {
          "settings": {
            "provider": {
              "only": [
                "decart/fp4",
                "inference-net/fp8",
                "sail-research/fp4",
                "deepinfra/fp8",
                "relace",
              ],
            },
          },
        },
        "minimax/minimax-m3": {
          "settings": {
            "provider": {
              "only": ["minimax"],
            },
          },
        },
        "minimax/minimax-m3.1-flash": {
          "settings": {
            "provider": {
              "only": ["minimax"],
            },
          },
        },
        "z-ai/glm-5.3": {
          "settings": {
            "provider": {
              "only": [
                "wafer/us",
                "wafer/fp4",
                "sail-research/fp8",
                "relace",
                "siliconflow/fp8",
                "novita/fp8",
                "inference-net/fp4",
              ],
            },
          },
        },
        "z-ai/glm-5.3-flash": {
          "settings": {
            "provider": {
              "only": [
                "open-inference/fp4",
                "streamlake/fp8",
                "novita/fp8",
                "relace",
                "sail-research/fp4",
                "gmicloud/fp8",
              ],
            },
          },
        },
        "xiaomi/mimo-v2.6-flash": {
          "settings": {
            "provider": {
              "only": ["makora/fp8", "novita/fp8", "xiaomi/fp8"],
            },
          },
        },
      },
    },
  },
  "compaction": {
    "auto": false,
  },
  "experimental": {
    "todo": true,
    "subagent_depth": 2,
    "image_generate": {
      "model": "openrouter/bytedance-seed/seedream-5-0-flash"
    },
  },
}

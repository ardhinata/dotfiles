{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
    },
    "read": {
      "~/.ssh/*": "deny",
      "~/.ssh/config": "allow",
      "~/.ssh/config.d": "allow",
      "/tmp/kilo/*": "allow",
    },
    "edit": {
      ".agents/docs/cache/**": "allow",
      ".agents/docs/**": "allow",
      ".agents/kilo/**": "allow",
      ".agents/**": "allow",
      ".tmp/**": "allow",
      "/tmp/kilo/*": "allow",
    },
    "external_directory": {
      "/tmp/kilo/*": "allow",
      "/tmp/*": "allow",
    },
    "interactive_terminal": {
      "*": "ask",
    },
    "kilo_memory_recall": {
      "*": "allow",
    },
    "kilo_memory_save": {
      "*": "allow",
    },
  },
  "model": "openrouter/minimax/minimax-m3",
  "small_model": "openrouter/~deepseek/deepseek-v4-flash-latest",
  "agent": {
    "orchestrator": {
      "disable": true,
      "hidden": false,
    },
  },
  "layout": "auto",
  "share": "auto",
  "remote_control": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "threshold_percent": 70,
  },
  "experimental": {
    "batch_tool": true,
    "codebase_search": false,
    "agent_manager_tool": true,
    "openTelemetry": true,
    "mcp_timeout": 30000,
    "swe_pruner": true,
    "continue_loop_on_deny": true,
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "headers": {
        "DEFAULT_PARAMETERS": "{\"include_images\":true, \"search_depth\": \"basic\", \"max_results\": 10}",
      },
      "enabled": true,
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
      "enabled": true,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true,
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "X-API-KEY": "{env:EXA_SEARCH_API_TOKEN}",
      },
      "enabled": false,
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
      },
      "enabled": false,
    },
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KILO_CLI}",
        "provider": {
          "sort": "price",
        },
      },
      "models": {
        "minimax/minimax-m3": {
          "options": {
            "provider": {
              "only": ["minimax/fp8"],
            },
          },
        },
        "openai/gpt-5.6-luna": {
          "options": {
            "provider": {
              "only": ["openai"],
              "order": ["openai"],
            },
            "reasoning": {
              "effort": "medium",
            },
          },
        },
        "openai/gpt-5.6-luna-pro": {
          "options": {
            "provider": {
              "only": ["openai"],
              "order": ["openai"],
            },
            "reasoning": {
              "effort": "high",
            },
          },
        },
        "z-ai/glm-5.2": {
          "options": {
            "provider": {
              "only": ["novita/fp8"],
              "order": ["novita/fp8"],
            },
          },
        },
        "deepseek/deepseek-v4-pro-0813": {
          "options": {
            "provider": {
              "only": ["deepseek"],
              "order": ["deepseek"],
            },
          },
        },
        "~deepseek/deepseek-v4-flash-latest": {
          "options": {
            "provider": {
              "only": ["deepseek"],
              "order": ["deepseek"],
            },
          },
        },
        "deepseek/deepseek-v4-flash-0731": {
          "options": {
            "provider": {
              "only": ["deepseek"],
              "order": ["deepseek"],
            },
          },
        },
      },
    },
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_SUBSCRIPTION_API}",
      },
    },
  },
  "indexing": {
    "model": "qwen/qwen3-embedding-8b",
    "provider": "openrouter",
    "openrouter": {
      "apiKey": "{env:OPENROUTER_API_KILO_INDEX}",
      "specificProvider": "nebius",
    },
    "searchMinScore": 0.5,
    "searchMaxResults": 8,
    "embeddingBatchSize": 1200,
    "scannerMaxBatchRetries": 5,
    "dimension": 1536,
  },
  "subagent_model": "openrouter/~deepseek/deepseek-v4-flash-latest",
  "instructions": [
    "~/.config/kilo/rules/*.md",
    "~/.config/kilo/rules.personal.d/*.md",
  ],
  "sandbox": {
    "enabled": false,
    "network": "allow",
  },
  "subagent_variant_overrides": {
    "openrouter/~deepseek/deepseek-v4-flash-latest": "high",
  },
  "web_search": true,
}

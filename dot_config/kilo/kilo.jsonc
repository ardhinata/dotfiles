{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
    },
    "read": {
      "~/.ssh/*": "deny",
      "~/.ssh/config": "allow",
      "~/.ssh/config.d": "allow",
      "/tmp/kilo/*": "allow",
    },
    "edit": {
      ".agents/docs/cache/**": "allow",
      ".agents/docs/**": "allow",
      ".agents/kilo/**": "allow",
      ".agents/**": "allow",
      ".tmp/**": "allow",
      "/tmp/kilo/*": "allow",
    },
    "external_directory": {
      "/tmp/kilo/*": "allow",
      "/tmp/*": "allow",
    },
    "interactive_terminal": {
      "*": "ask",
    },
    "kilo_memory_recall": {
      "*": "allow",
    },
    "kilo_memory_save": {
      "*": "allow",
    },
  },
  "model": "openrouter/minimax/minimax-m3",
  "small_model": "openrouter/~deepseek/deepseek-v4-flash-latest",
  "agent": {
    "orchestrator": {
      "disable": true,
      "hidden": false,
    },
  },
  "layout": "auto",
  "share": "auto",
  "remote_control": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "threshold_percent": 70,
  },
  "experimental": {
    "batch_tool": true,
    "codebase_search": false,
    "agent_manager_tool": true,
    "openTelemetry": true,
    "mcp_timeout": 30000,
    "swe_pruner": true,
    "continue_loop_on_deny": true,
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "enabled": true,
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/v2/mcp-oauth",
      "enabled": true,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp/oauth",
      "enabled": true,
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "X-API-KEY": "{env:EXA_SEARCH_API_TOKEN}",
      },
      "enabled": false,
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
      },
      "enabled": false,
    },
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KILO_CLI}",
        "provider": {
          "sort": "price",
        },
      },
      "models": {
        "minimax/minimax-m3": {
          "options": {
            "provider": {
              "only": ["minimax/fp8"],
            },
          },
        },
        "openai/gpt-5.6-luna": {
          "options": {
            "provider": {
              "only": ["openai/flex", "azure", "openai", "amazon-bedrock/us-east-1"],
            },
            "reasoning": {
              "effort": "medium",
            },
          },
        },
        "openai/gpt-5.6-luna-pro": {
          "options": {
            "provider": {
              "only": ["openai/flex", "azure", "openai", "azure/eu"],
            },
            "reasoning": {
              "effort": "high",
            },
          },
        },
        "z-ai/glm-5.2": {
          "options": {
            "provider": {
              "only": ["deepinfra/fp4", "sail-research/fp8", "ambient/fp8", "decart/fp4"],
            },
          },
        },
        "deepseek/deepseek-v4-pro-0813": {
          "options": {
            "provider": {
              "only": ["streamlake", "gmicloud/fp8", "alibaba", "deepinfra/fp8"],
            },
          },
        },
        "~deepseek/deepseek-v4-flash-latest": {
          // 2026-09-01: open-inference/fp8 removed (user-reported <1 tok/s);
          // sail-research, akashml, relace dropped because they do not
          // appear on the canonical deepseek/deepseek-v4-flash endpoint
          // listing any longer. Replaced by the top-3 by combined
          // throughput and price: baidu/fp8 (76 tok/s, $0.078/M,
          // 99.99% uptime) → alibaba/fp8 (78 tok/s, $0.134/M, 99.79%) →
          // cloudflare (71 tok/s, 99.98% uptime, already in use).
          "options": {
            "provider": {
              "only": ["baidu/fp8", "alibaba/fp8", "cloudflare"],
            },
          },
        },
        "deepseek/deepseek-v4-flash-0731": {
          // 2026-09-01 (route probe): sail-research/fp4 returned 429
          // (no_asap_capacity) and akashml/fp8 returned 503
          // (backends_unhealthy) on the 2026-09-01 probe; dropped.
          // relace/fp4 and streamlake/fp8 confirmed reasoning_effort
          // forwarding (12 + 10 reasoning tokens on a 1-token probe).
          "options": {
            "provider": {
              "only": ["relace/fp4", "streamlake/fp8"],
            },
          },
        },
        "z-ai/glm-5.3-flash": {
          // 2026-09-01 (route probe): parasail, deepinfra, novita all
          // forward reasoning_effort (9/7/6 tokens on a 1-token probe).
          // atlas-cloud/fp8 does not serve glm-5.3-flash-20260826.
          "options": {
            "provider": {
              "only": ["parasail/fp8", "deepinfra/fp8", "novita/fp8"],
            },
          },
        },
        "xiaomi/mimo-v2.5-pro": {
          // 2026-09-01 (route probe): deepinfra and xiaomi/fp8 confirmed.
          // gmicloud/fp8 and parasail/fp8 do not serve
          // xiaomi/mimo-v2.5-pro-20260422.
          "options": {
            "provider": {
              "only": ["deepinfra/fp8", "xiaomi/fp8"],
            },
          },
        },
        "z-ai/glm-4.7-flash": {
          "options": {
            "provider": {
              "only": ["deepinfra/bf16", "venice/fp8", "cloudflare", "novita/bf16"],
            },
          },
        },
        "google/gemini-2.5-flash-lite": {
          "options": {
            "provider": {
              "only": ["google-ai-studio/flex", "google-vertex/eu", "google-vertex", "google-ai-studio"],
            },
          },
        },
        "xiaomi/mimo-v2.5": {
          // 2026-09-01: top-4 cheapest T+Tb-supporting providers per the
          // OpenRouter endpoint pull. The 2026-08-26 A1 revert note
          // (parasail/fp8 returning HTTP 429) is preserved here as
          // historical context — parasail now sits 4th, not 2nd, and
          // OpenRouter's auto-fallback (now disabled by `only`) would
          // no longer reach it if it 429s again.
          "options": {
            "provider": {
              "only": ["gmicloud/fp8", "deepinfra/fp8", "xiaomi/fp8", "parasail/fp8"],
            },
          },
        },
        "google/gemma-4-31b-it": {
          "options": {
            "provider": {
              "only": ["coreweave/fp4", "venice/bf16", "chutes/fp4", "deepinfra/fp8"],
            },
          },
        },
        "meta/muse-spark-1.2-contributor": {
          "options": {
            "provider": {
              "only": ["meta"],
            },
          },
        },
        "tencent/hy3": {
          "options": {
            "provider": {
              "only": ["tencent/fp8", "deepinfra/fp8", "novita", "phala"],
            },
          },
        },
        // 2026-09-01 Mix A — see
        // .agents/docs/cache/openrouter/2026-09-01-fleet-revaluation.md.
        // Dated permaslugs (-20260731 / -20260826 / -20260727) removed
        // 2026-09-01 per user request; the dated entries duplicated
        // coverage of the non-dated ids above. Provider routing lives
        // in the canonical non-dated entries only.
      },
    },
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_SUBSCRIPTION_API}",
      },
    },
  },
  "indexing": {
    "model": "qwen/qwen3-embedding-8b",
    "provider": "openrouter",
    "openrouter": {
      "apiKey": "{env:OPENROUTER_API_KILO_INDEX}",
      "specificProvider": "nebius",
    },
    "searchMinScore": 0.5,
    "searchMaxResults": 8,
    "embeddingBatchSize": 1200,
    "scannerMaxBatchRetries": 5,
    "dimension": 1536,
  },
  "subagent_model": "openrouter/~deepseek/deepseek-v4-flash-latest",
  "instructions": [
    "~/.config/kilo/rules/*.md",
    "~/.config/kilo/rules.personal.d/*.md",
  ],
  "sandbox": {
    "enabled": false,
    "network": "allow",
  },
  "subagent_variant_overrides": {
    "openrouter/~deepseek/deepseek-v4-flash-latest": "high",
  },
  "web_search": true,
}

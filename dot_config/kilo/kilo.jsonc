{
  "$schema": "https://app.kilo.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow",
    },
    "edit": {
      ".agents/docs/cache/**": "allow",
      ".agents/docs/**": "allow",
      ".agents/kilo/**": "allow",
      ".agents/**": "allow",
      ".tmp/**": "allow",
    },
    "external_directory": {
      "/tmp/kilo/*": "allow",
      "/tmp/*": "allow",
    },
    "interactive_terminal": {
      "*": "ask",
    },
    "kilo_memory_recall": {
      "*": "allow",
    },
    "kilo_memory_save": {
      "*": "allow",
    },
  },
  "model": "openrouter/minimax/minimax-m3",
  "small_model": "openrouter/deepseek/deepseek-v4-flash",
  "agent": {
    "orchestrator": {
      "disable": true,
      "hidden": false,
    },
  },
  "layout": "auto",
  "share": "auto",
  "remote_control": true,
  "compaction": {
    "auto": true,
    "prune": true,
    "threshold_percent": 70,
  },
  "experimental": {
    "batch_tool": false,
    "codebase_search": false,
    "agent_manager_tool": true,
    "openTelemetry": true,
    "mcp_timeout": 30000,
    "swe_pruner": true,
    "swe_pruner_model": "openrouter/deepseek/deepseek-v4-pro",
    "continue_loop_on_deny": true,
  },
  "mcp": {
    "tavily": {
      "type": "remote",
      "url": "https://mcp.tavily.com/mcp",
      "headers": {
        "Authorization": "Bearer {env:TAVILY_API_TOKEN}",
        "DEFAULT_PARAMETERS": "{\"include_images\":true, \"search_depth\": \"basic\", \"max_results\": 8}",
      },
      "enabled": true,
    },
    "firecrawl": {
      "type": "remote",
      "url": "https://mcp.firecrawl.dev/{env:FIRECRAWL_API_TOKEN}/v2/mcp",
      "enabled": true,
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_TOKEN}",
      },
      "enabled": true,
    },
    "exa": {
      "type": "remote",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "X-API-KEY": "{env:EXA_SEARCH_API_TOKEN}",
      },
      "enabled": false,
    },
    "github": {
      "type": "remote",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer {env:GITHUB_TOKEN}",
      },
      "enabled": false,
    },
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/",
      "enabled": false,
    },
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:OPENROUTER_API_KILO_CLI}",
        "provider": {
          "sort": "price",
        },
      },
      "models": {
        "deepseek/deepseek-v4-flash": {
          "options": {
            "provider": {
              "only": ["deepseek"],
              "order": ["deepseek"],
            },
            "reasoning": {
              "effort": "medium",
            },
          },
        },
        "deepseek/deepseek-v4-pro": {
          "options": {
            "provider": {
              "only": ["deepseek"],
              "order": ["deepseek"],
            },
            "reasoning": {
              "effort": "medium",
            },
          },
        },
        "google/gemini-3.1-flash-lite": {
          "options": {
            "service_tier": "flex",
          },
        },
        "minimax/minimax-m3": {
          "options": {
            "provider": {
              "only": ["minimax/fp8"],
            },
          },
        },
      },
    },
    "minimax": {
      "options": {
        "apiKey": "{env:MINIMAX_SUBSCRIPTION_API}",
      },
    },
  },
  "indexing": {
    "model": "qwen/qwen3-embedding-8b",
    "provider": "openrouter",
    "openrouter": {
      "apiKey": "{env:OPENROUTER_API_KILO_INDEX}",
      "specificProvider": "nebius",
    },
    "searchMinScore": 0.5,
    "searchMaxResults": 8,
    "embeddingBatchSize": 240,
    "scannerMaxBatchRetries": 5,
    "dimension": 4096,
  },
  "subagent_model": "openrouter/deepseek/deepseek-v4-flash",
  "instructions": ["~/.config/kilo/rules/*.md"],
  "sandbox": {
    "enabled": false,
    "network": "allow",
  },
  "subagent_variant_overrides": {
    "openrouter/deepseek/deepseek-v4-flash": "high",
  },
}

# shellcheck disable=all
# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
	source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Shell tool directory
SHELL_TOOL_DIR="${HOME}/.shell"
ZGENOM_DIR="${SHELL_TOOL_DIR}/zgenom"

source "${SHELL_TOOL_DIR}/zsh/00-before-zgenom.zsh"

# Disable Prezto autoload plugin
export ZGEN_PREZTO_LOAD_DEFAULT=0

source "${ZGENOM_DIR}/zgenom.zsh"

# Zgenom definition

# Check for plugin and zgenom updates every 7 days
# This does not increase the startup time.
zgenom autoupdate

# Regenerate the prezto init script when it is missing, when the compiled
# .zshrc is missing, or when this file changed since the last generation.
# The module list lives in the generated init script, not in this file, so a
# changed module list needs a regeneration to take effect.
if ! zgenom saved || [[ ! -f "${HOME}/.zshrc.zwc" ]] || [[ "${HOME}/.zshrc" -nt "${ZGEN_INIT}" ]]; then

	# Prezto load
	zgenom prezto

	# Module options
	zgenom prezto directory:alias skip "yes"
	zgenom prezto git:alias skip "yes"
	zgenom prezto history:alias skip "yes"
	zgenom prezto history histsize 1048576
	zgenom prezto utility:download helper "aria2c"
	zgenom prezto utility safe-ops "no"
	zgenom prezto prompt theme "powerlevel10k"
	zgenom prezto prompt managed "yes"
	zgenom prezto '*' color "yes"
	zgenom prezto prompt pwd-length "short"

	# Prezto modules
	# `environment` must be loaded explicitly: with ZGEN_PREZTO_LOAD_DEFAULT=0
	# prezto's defaults (which include `environment`) are skipped, and this is
	# the module that sets `setopt INTERACTIVE_COMMENTS` so `#` works at the
	# prompt.
	#
	# The order matters. `syntax-highlighting` must come before
	# `history-substring-search`, so the key binds of the search widget land
	# on top of the highlighting wrapper. `utility` must come before
	# `completion`, because `completion` snapshots `fpath` when it loads.
	zgenom prezto environment
	zgenom prezto terminal
	zgenom prezto archive
	zgenom prezto directory
	zgenom prezto git
	zgenom prezto history
	zgenom prezto rsync
	zgenom prezto utility
	zgenom prezto editor
	zgenom prezto completion
	zgenom prezto syntax-highlighting
	zgenom prezto history-substring-search
{{- if eq .chezmoi.os "darwin" }}

	# macOS only.
	#
	# `osx` gives the Finder, Quick Look and trash helpers. `command-not-found`
	# uses the Homebrew handler to suggest a package for a missing command.
	#
	# `homebrew` is not loaded. `brew shellenv` in
	# `dot_shell/zsh/00-before-zgenom.zsh` already exports the `HOMEBREW_`
	# variables, and the module only adds the `brewc`, `brewi`, `brewl` and
	# `brewo` aliases on top of that.
	#
	# `gnu-utility` is not loaded. It replaces the BSD coreutils with the GNU
	# ones, and the `utility` module then sets `alias ls='ls -G'`. GNU `ls`
	# reads `-G` as `--no-group`, so the listing loses its colors.
	zgenom prezto osx
	zgenom prezto command-not-found
{{- else }}

	# Linux only.
	#
	# `pacman` is the Arch package manager. The module returns early when the
	# `pacman` command is missing, so it is safe on a non-Arch host.
	zgenom prezto pacman
{{- end }}
	zgenom prezto prompt

	# generate the init script from plugins above
	zgenom save

	# Compile only the top-level config files. Skipping the recursive
	# compile of SHELL_TOOL_DIR avoids stale .zwc bytecode shadowing source
	# edits (see dot_shell/zsh/10-common-export.zsh comment for details).
	# The startup cost of reading .zsh source for our small helper files
	# is negligible compared to the footgun.
	zgenom compile "${HOME}/.zshrc"
	zgenom compile "${HOME}/.zprofile"
	zgenom compile "${HOME}/.zshenv"
fi

source "${SHELL_TOOL_DIR}/zsh/10-common-export.zsh"
source "${SHELL_TOOL_DIR}/zsh/12-gpg.zsh"
source "${SHELL_TOOL_DIR}/zsh/15-zgenom-helper-func.zsh"
source "${SHELL_TOOL_DIR}/zsh/20-secret-env-load.zsh"

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

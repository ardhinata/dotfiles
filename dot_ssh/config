Include config.d/*.single.conf
Include config.d/*.group.conf
Include config.d/*.general.conf

## Apply to all host
Host *
    CheckHostIP yes
    HashKnownHosts yes
    HostKeyAlgorithms -ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp384-cert-v01@openssh.com,ecdsa-sha2-nistp521-cert-v01@openssh.com,sk-ecdsa-sha2-nistp256-cert-v01@openssh.com,ecdsa-sha2-nistp256,ecdsa-sha2-nistp384,ecdsa-sha2-nistp521,sk-ecdsa-sha2-nistp256@openssh.com,webauthn-sk-ecdsa-sha2-nistp256@openssh.com
    KexAlgorithms -ecdh-sha2-nistp256,ecdh-sha2-nistp384,ecdh-sha2-nistp521,diffie-hellman-group14-sha256
    MACs -umac-64-etm@openssh.com,hmac-sha1-etm@openssh.com,umac-64@openssh.com,umac-128@openssh.com,hmac-sha2-256,hmac-sha2-512,hmac-sha1
    StrictHostKeyChecking accept-new
    VisualHostKey yes

## Tell gpg-agent about the current TTY before each SSH session.
## gpg-agent under systemd --user has no controlling terminal, so when
## ssh asks it to sign, the agent has no TTY to spawn pinentry on. This
## exec runs gpg-connect-agent(1) updatestartuptty, which updates the
## agent's idea of the current TTY so the agent forks pinentry with that
## TTY as input. Works in any normal terminal session; does NOT help in a
## VSCode tunnel with no local display (the agent still has no TTY to
## forward). Workaround for upstream gnupg T6478.
Match host * exec "gpg-connect-agent updatestartuptty /bye"

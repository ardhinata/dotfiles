{{- $profile := promptStringOnce . "system_environment.profile" "Which profile should be used?" -}}
{{- $machineName := promptStringOnce . "system_environment.machine_name" "What is the machine name?" -}}
{{- $nonce := dig "system_environment" "nonce" "" . | toString -}}
{{- if ne (len (nospace $nonce)) 64 -}}
{{-   $nonce = randAlphaNum 64 -}}
{{- end -}}
encryption: "age"
age:
  identities:
{{ (glob (joinPath .chezmoi.sourceDir ".encryption_keys" "*.secret.key")) | toYaml | indent 4 }}
  recipientsFiles:
{{ (glob (joinPath .chezmoi.sourceDir ".encryption_keys" "*.public.key")) | toYaml | indent 4 }}
data:
  system_environment:
    profile: {{ $profile | quote }}
    nonce: {{ $nonce | quote }}
    machine_name: {{ $machineName | quote }}

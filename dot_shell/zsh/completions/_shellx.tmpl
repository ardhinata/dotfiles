#compdef shellx
# Zsh completion for the shellx secret manager.
# Tag/process completion delegates to a tiny stdlib helper script
# (`shellx_completion_helper`) instead of `jq` so the runtime has zero
# third-party tool dependencies.
#
# As of shellx 1.4.0, exec-mode completion (process names + per-process
# args) is reachable via the explicit `shellx run` subcommand:
#   shellx run cod<TAB>     -> code
#   shellx run --tab=<TAB>  -> tags from the store
# Bare `shellx <TAB>` (exec-mode fallback path) no longer triggers
# process-name completion — it intentionally only lists subcommands so
# `init`/`store`/`list`/`rm`/`export`/`import`/`run` stay unambiguous.

local curcontext="$curcontext" state line ret=1
typeset -A opt_args

local -a subcommands
subcommands=(
  'init:Initialize the shellx store'
  'store:Store a secret (value from stdin)'
  'list:List stored variables'
  'rm:Remove a stored variable'
  'export:Export the store to JSONC (encrypted by default)'
  'import:Import a JSONC or .jsonc.age export'
  'run:Run a process with matching secrets injected (enables process-name completion)'
  'help:Show usage'
)

local helper="${SHELL_TOOL_DIR:-{{ .chezmoi.homeDir }}/.shell}/helper/shellx_completion_helper"

# Top-level dispatch: match the subcommand, then route to its per-subcommand
# handler. Each branch shifts `shellx <subcmd>` off $words/$CURRENT itself
# and completes the post-subcommand context directly with `compadd`,
# `_command_names`, `_files`, or `_vars` — bypassing `_arguments`, which
# interacts badly with the `--` end-of-options marker and with `*:`/`*::`
# state-action transitions in nested contexts.
_arguments -C -s \
  '1: :->cmd' \
  '*:arg:->args'

case $state in
  cmd)
    _describe 'subcommand' subcommands
    ;;
  args)
    local subcmd=$words[2]
    case $subcmd in
      init)
        ret=0
        ;;
      store)
        shift 2 words
        (( CURRENT -= 2 ))
        # PREFIX starts with `-` → cursor sits on an option prefix;
        # offer the option names. Otherwise complete stored var names.
        if [[ $PREFIX == -* ]]; then
          compadd -Q -- '--tag' '--process'
        else
          _vars
        fi
        ret=0
        ;;
      rm)
        shift 2 words
        (( CURRENT -= 2 ))
        _vars
        ret=0
        ;;
      export)
        shift 2 words
        (( CURRENT -= 2 ))
        compadd -Q -- '--to' '--label' '--no-encrypt'
        ret=0
        ;;
      import)
        shift 2 words
        (( CURRENT -= 2 ))
        if [[ $PREFIX == -* ]]; then
          compadd -Q -- '--to' '--slug' '--force' '--dry-run'
        else
          _files -g '*.jsonc *.json *.age'
        fi
        ret=0
        ;;
      run)
        local -a tags
        if [[ -x "$helper" ]]; then
          tags=(${(f)"$($helper tags 2>/dev/null)"})
        fi
        shift 2 words
        (( CURRENT -= 2 ))
        # Three cursor shapes after `shellx run`:
        #   PREFIX=`--*`  → completing an option; offer --tag / --process.
        #                  (The `--tag=<TAB>` / `--process=<TAB>` value path
        #                   is not implemented here; tags/processes still
        #                   complete via the option name itself.)
        #   PREFIX=`-`    → no short options for `run`; fall through.
        #   otherwise     → the cursor sits on the first non-option word;
        #                  strip --tag*/--process* and any other - flags from
        #                  $words, count the remainder. <=1 word → user is
        #                  typing the process name (partial or full) → offer
        #                  command names. >1 word → user is past the process
        #                  name → delegate to `_normal` so the process's own
        #                  completion finishes the line.
        if [[ $PREFIX == --* ]]; then
          compadd -Q -- '--tag' '--process'
          ret=0
        elif [[ $PREFIX == -* ]]; then
          ret=0
        else
          local -a after_opts
          after_opts=()
          local w
          for w in "${words[@]}"; do
            [[ "$w" == --tag=* || "$w" == --tag || "$w" == --process=* || "$w" == --process ]] && continue
            [[ "$w" == -* ]] && continue
            after_opts+=("$w")
          done
          if (( ${#after_opts} <= 1 )); then
            _command_names -e
          else
            # Rebuild words/CURRENT so `_normal` sees the process name as
            # $words[1] and the rest of its args.
            local proc=${after_opts[1]}
            words=("$proc" "${after_opts[@]:2}" "")
            CURRENT=2
            _normal
          fi
          ret=0
        fi
        ;;
      help|--help|-h)
        ret=0
        ;;
      *)
        # Bare `shellx <cmd> [args...]` exec mode (legacy fallback). No
        # process-name completion here by design — keep `shellx <TAB>`
        # quiet so subcommands stay unambiguous. The `shellx run` form
        # above is the supported way to get completion.
        ret=0
        ;;
    esac
    ;;
esac

return ret

_vars() {
  local -a vs
  if [[ -x "$helper" ]]; then
    vs=(${(f)"$($helper vars 2>/dev/null)"})
  fi
  (( $#vs )) && compadd -a vs
}
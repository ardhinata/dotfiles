#compdef shellx
# Zsh completion for the shellx secret manager.
# Tag/process completion delegates to a tiny stdlib helper script
# (`shellx_completion_helper`) instead of `jq` so the runtime has zero
# third-party tool dependencies.
#
# As of shellx 1.4.0, exec-mode completion (process names + per-process
# args) is reachable via the explicit `shellx run` subcommand:
#   shellx run cod<TAB>     -> code
#   shellx run --tab=<TAB>  -> tags from the store
# Bare `shellx <TAB>` (exec-mode fallback path) no longer triggers
# process-name completion — it intentionally only lists subcommands so
# `init`/`store`/`list`/`rm`/`export`/`import`/`run` stay unambiguous.
# Backward compatibility: `shellx --tag=... -- proc args...` and
# `shellx proc args...` still work exactly as before; `shellx run ...
# behaves identically.

local curcontext="$curcontext" state line ret=1
typeset -A opt_args

local -a subcommands
subcommands=(
  'init:Initialize the shellx store'
  'store:Store a secret (value from stdin)'
  'list:List stored variables'
  'rm:Remove a stored variable'
  'export:Export the store to JSONC (encrypted by default)'
  'import:Import a JSONC or .jsonc.age export'
  'run:Run a process with matching secrets injected (enables process-name completion)'
  'help:Show usage'
)

local helper="${SHELL_TOOL_DIR:-{{ .chezmoi.homeDir }}/.shell}/helper/shellx_completion_helper"

_arguments -C -s \
  '1: :->cmd' \
  '*::arg:->args' \
  && ret=0

case "$state" in
  cmd)
    _describe 'subcommand' subcommands
    ret=0
    ;;
  args)
    case $words[1] in
      init)
        ret=0
        ;;
      store)
        _arguments \
          '1:var:_vars' \
          '--tag[Tag (repeatable)]' \
          '--process[Process name to match (repeatable)]'
        ret=0
        ;;
      rm)
        _arguments '1:var:_vars'
        ret=0
        ;;
      export)
        _arguments \
          '--to[Destination directory]' \
          '--label[Filename label override]' \
          '--no-encrypt[Write plaintext JSONC (unsafe)]'
        ret=0
        ;;
      import)
        _arguments \
          '1:file:_files -g "*.jsonc *.json *.age"' \
          '--to[Target store directory]' \
          '--slug[Target slug]' \
          '--force[Overwrite existing entries]' \
          '--dry-run[Show what would be imported]'
        ret=0
        ;;
      run)
        # Exec mode via explicit `shellx run` subcommand: enables
        # process-name + tag + per-process arg completion without
        # polluting the parent `shellx` completion.
        local -a tags
        if [[ -x "$helper" ]]; then
          tags=(${(f)"$($helper tags 2>/dev/null)"})
        fi
        _arguments \
          '--tag[Filter by tag]:tag:->tags' \
          '--process[Process name to match]:process:->processes' \
          '*::args:->rest'
        case "$state" in
          tags)
            (( $#tags )) && _wanted tags expl 'tag' compadd -a tags
            ret=0
            ;;
          processes)
            _command_names -e
            ret=0
            ;;
          rest)
            local process_name
            # words[1] is the literal `run`; scan from index 2 for the first
            # non-option, non-flag value.
            for w in "${words[@]:2}"; do
              [[ "$w" == --tag* ]] && continue
              [[ "$w" == --process* ]] && continue
              [[ "$w" == -* ]] && continue
              process_name="$w"
              break
            done
            if [[ -n "$process_name" ]] && (( $+commands[$process_name] )); then
              shift words
              (( CURRENT-- ))
              _normal -p "$service"
              ret=$?
            else
              _default && ret=0
            fi
            ;;
        esac
        ;;
      help|--help|-h)
        ret=0
        ;;
      *)
        # Bare `shellx <cmd> [args...]` exec mode (legacy fallback). No
        # process-name completion here by design — keep `shellx <TAB>`
        # quiet so subcommands stay unambiguous. The `shellx run` form
        # above is the supported way to get completion.
        ret=0
        ;;
    esac
    ;;
esac

return ret

_vars() {
  local -a vs
  if [[ -x "$helper" ]]; then
    vs=(${(f)"$($helper vars 2>/dev/null)"})
  fi
  (( $#vs )) && compadd -a vs
}
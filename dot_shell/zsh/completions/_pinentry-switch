#compdef pinentry-switch

local -a subcommands backends
subcommands=(
	'auto:Restore the wrapper'\''s DE-based auto-dispatch'
	'list:List installed backends'
	'current:Print the active override (or auto)'
	'status:Show override and resolved backend'
)

backends=( /usr/bin/pinentry-*(-xN:t) )
backends=( ${backends##*pinentry-} )
backends=( ${backends%.*} )

local curcontext="$curcontext" state line ret=1
typeset -A opt_args

_arguments -C \
	'1: :->cmd' \
	'*::arg:->args' \
	&& ret=0

case $state in
	cmd)
		_describe -t subcommands 'subcommand' subcommands -- backends
		ret=0
		;;
	args)
		case $words[2] in
			list|current|status|auto)
				;;
			*)
				(( $#backends )) && _describe -t backends 'backend' backends
				ret=0
				;;
		esac
		;;
esac

return ret

# ~/.shell/.zshenv
# Sourced by ~/.zshenv, so every zsh reads it: login, interactive and
# non-interactive. Keep it small and silent.
#
# This file is managed by chezmoi and holds no secret. The values come from
# the shellx store, which lives outside the repo.

[ -r "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"

# Jira and Bitbucket. One shellx call covers all four variables, so a shell
# pays for one decryption instead of four. xtrace is off across the eval, so
# `zsh -x` cannot print a value.
if [ -x "$HOME/.shell/helper/shellx" ]; then
	_shellx_xtrace=
	case $- in *x*) _shellx_xtrace=1; set +x ;; esac
	if _shellx_env="$("$HOME/.shell/helper/shellx" env \
		JIRA_URL JIRA_EMAIL JIRA_API_TOKEN BITBUCKET_API_TOKEN)"; then
		eval "$_shellx_env"
	else
		printf 'shellx: warning: failed to load the Jira and Bitbucket secrets\n' >&2
	fi
	if [ -n "$_shellx_xtrace" ]; then set -x; fi
	unset _shellx_env _shellx_xtrace
fi

#!/usr/bin/env python3
# shellx — stealth-first secret manager for the chezmoi dotfiles repo.
#
# This is the launcher. The subcommands live in `shellx_impl.py` next to
# this file, so Python reuses the cached bytecode instead of parsing the
# whole implementation on every call.
#
# Pure Python 3 stdlib (no pip, no venv). See dot_shell/helper/.help/ for
# the documentation.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from shellx_impl import main  # noqa: E402

if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        sys.exit(130)

#!/usr/bin/env bash
# pinentry-switch — pinentry backend owner for this host.
#
# Owns two files (neither is chezmoi-managed):
#   1. ~/.gnupg/gpg-agent.conf — set up via `init` (idempotent).
#      The wrapper at ~/.shell/helper/pinentry-wrapper is referenced by
#      `pinentry-program` in this file. On a fresh machine, run `init` once
#      after `chezmoi apply`.
#   2. ${XDG_CONFIG_HOME:-$HOME/.config}/pinentry/mode — runtime override,
#      written by `<backend>` / cleared by `auto`. Read by the wrapper on
#      every invocation.
#
# Subcommands:
#   <backend>     set the backend override (qt, gnome3, gtk, curses, tty, ...)
#   auto          clear the override (wrapper picks via DE-based heuristic)
#   list          list installed backends
#   current       print the active override (auto if unset)
#   status        print override + resolved backend
#   init          idempotently set up ~/.gnupg/gpg-agent.conf
#   init --force  same, but replace an existing pinentry-program line

set -euo pipefail

mode_file="${XDG_CONFIG_HOME:-$HOME/.config}/pinentry/mode"
wrapper="$HOME/.shell/helper/pinentry-wrapper"
gnupg_conf="${GNUPGHOME:-$HOME/.gnupg}/gpg-agent.conf"

usage() {
	cat <<EOF
pinentry-switch <backend|auto|list|current|status|init [--force]>

Valid backends: qt, gnome3, gtk, curses, tty
EOF
}

list_backends() {
	local b
	for b in /usr/bin/pinentry-*; do
		[[ -x "$b" ]] || continue
		b=${b##*/pinentry-}
		[[ "$b" == *.* ]] && continue
		[[ -z "$b" ]] && continue
		printf '%s\n' "$b"
	done | sort -u
}

current_mode() {
	if [[ -r "$mode_file" ]]; then
		tr -d '[:space:]' < "$mode_file"
	else
		printf 'auto\n'
	fi
}

validate_backend() {
	local backend="$1"
	if [[ ! "$backend" =~ ^[a-z0-9_-]+$ ]]; then
		printf 'pinentry-switch: invalid backend name: %s\n' "$backend" >&2
		return 1
	fi
	if [[ ! -x "/usr/bin/pinentry-$backend" ]]; then
		printf 'pinentry-switch: /usr/bin/pinentry-%s not found\n' "$backend" >&2
		printf '  installed: %s\n' "$(list_backends | tr '\n' ' ')" >&2
		return 1
	fi
	if ldd "/usr/bin/pinentry-$backend" 2>/dev/null | grep -q 'not found'; then
		printf 'pinentry-switch: /usr/bin/pinentry-%s has missing libraries:\n' "$backend" >&2
		ldd "/usr/bin/pinentry-$backend" 2>/dev/null | grep 'not found' >&2
		return 1
	fi
}

# Read the first `pinentry-program` value (path) from an existing config.
# Empty string if not set.
existing_pinentry_program() {
	local conf="$1"
	[[ -r "$conf" ]] || { printf '\n'; return; }
	awk '
		/^[[:space:]]*pinentry-program[[:space:]]/ {
			val = ""
			for (i = 2; i <= NF; i++) val = val (i == 2 ? "" : " ") $i
			print val
			exit
		}
	' "$conf"
}

# Ensure a default key=value line is present (silent on present, append on absent).
ensure_default_line() {
	local conf="$1" line="$2"
	local key="${line%% *}"
	if ! grep -qE "^[[:space:]]*${key//\//\\/}([[:space:]]|$)" "$conf" 2>/dev/null; then
		printf '%s\n' "$line" >> "$conf"
	fi
}

# Idempotent setup of ~/.gnupg/gpg-agent.conf.
# Contract: see .tmp/plans/2026-08-08-pinentry-wrapper-pivot.md.
init_gpg_agent_conf() {
	local force=0
	if [[ "${1:-}" == "--force" ]]; then
		force=1
	elif [[ -n "${1:-}" ]]; then
		printf 'pinentry-switch: init takes no args or --force\n' >&2
		return 2
	fi

	if [[ ! -x "$wrapper" ]]; then
		printf 'pinentry-switch: wrapper not found at %s\n' "$wrapper" >&2
		printf '  run `chezmoi apply` first, then retry\n' >&2
		return 1
	fi

	mkdir -p -- "${gnupg_conf%/*}"
	chmod 700 -- "${gnupg_conf%/*}"

	if [[ ! -f "$gnupg_conf" ]]; then
		{
			printf 'enable-ssh-support\n'
			printf 'pinentry-program %s\n' "$wrapper"
			printf 'default-cache-ttl 7200\n'
			printf 'max-cache-ttl 86400\n'
			printf 'default-cache-ttl-ssh 7200\n'
			printf 'max-cache-ttl-ssh 86400\n'
		} > "$gnupg_conf"
		chmod 600 "$gnupg_conf"
		printf 'pinentry-switch: init wrote %s\n' "$gnupg_conf"
		return 0
	fi

	local current
	current=$(existing_pinentry_program "$gnupg_conf")

	if [[ -n "$current" ]]; then
		if [[ "$current" == "$wrapper" ]]; then
			printf 'pinentry-switch: init: pinentry-program already points at wrapper\n'
		else
			if (( !force )); then
				printf 'pinentry-switch: refusing to overwrite pinentry-program\n' >&2
				printf '  current: %s\n' "$current" >&2
				printf '  desired: %s\n' "$wrapper" >&2
				printf '  re-run with --force to replace in place\n' >&2
				return 1
			fi
			# --force: replace the line in place
			local tmp
			tmp=$(mktemp "${gnupg_conf}.XXXXXX") || return 1
			awk -v new="pinentry-program $wrapper" '
				/^[[:space:]]*pinentry-program[[:space:]]/ { print new; next }
				{ print }
			' "$gnupg_conf" > "$tmp" && mv "$tmp" "$gnupg_conf"
			chmod 600 "$gnupg_conf"
			printf 'pinentry-switch: init --force: replaced pinentry-program in %s\n' "$gnupg_conf"
		fi
	else
		# No pinentry-program line present: append.
		printf '\npinentry-program %s\n' "$wrapper" >> "$gnupg_conf"
		chmod 600 "$gnupg_conf"
		printf 'pinentry-switch: init: appended pinentry-program to %s\n' "$gnupg_conf"
	fi

	# Silently append any missing defaults.
	local missing=0
	for line in 'enable-ssh-support' 'default-cache-ttl 7200' 'max-cache-ttl 86400' 'default-cache-ttl-ssh 7200' 'max-cache-ttl-ssh 86400'; do
		local key="${line%% *}"
		# Match the key followed by whitespace or end-of-line (so a bare
		# `enable-ssh-support` line is correctly detected as present).
		if ! grep -qE "^[[:space:]]*${key//\//\\/}([[:space:]]|$)" "$gnupg_conf" 2>/dev/null; then
			printf '%s\n' "$line" >> "$gnupg_conf"
			missing=1
		fi
	done
	if (( missing )); then
		printf 'pinentry-switch: init: appended missing defaults to %s\n' "$gnupg_conf"
	fi

	# Recovery hint for agents that haven't seen the new pinentry-program yet.
	printf '  next: gpgconf --reload gpg-agent\n'
}

cmd="${1:-}"

case "$cmd" in
	''|-h|--help|help)
		usage
		exit 0
		;;
	list)
		list_backends
		;;
	current)
		current_mode
		;;
	auto)
		if [[ -e "$mode_file" ]]; then
			rm -f -- "$mode_file"
			echo "pinentry-switch: override cleared (auto-dispatch restored)"
		else
			echo "pinentry-switch: already auto"
		fi
		;;
	status)
		cur=$(current_mode)
		printf 'override: %s\n' "$cur"
		if [[ "$cur" != "auto" ]]; then
			bin="/usr/bin/pinentry-$cur"
			if [[ -x "$bin" ]]; then
				if ldd "$bin" 2>/dev/null | grep -q 'not found'; then
					echo "backend:  $bin (MISSING LIBS)"
				else
					echo "backend:  $bin (OK)"
				fi
			else
				echo "backend:  $bin (NOT INSTALLED)"
			fi
		else
			echo "backend:  <wrapper auto-dispatch>"
		fi
		# Surface init hint if the agent config is missing the wrapper line.
		if [[ -r "$gnupg_conf" ]]; then
			current_pp=$(existing_pinentry_program "$gnupg_conf")
			if [[ -z "$current_pp" ]]; then
				printf 'agent:    <no pinentry-program set — run `pinentry-switch init`>\n'
			elif [[ "$current_pp" != "$wrapper" ]]; then
				printf 'agent:    pinentry-program=%s (NOT the wrapper)\n' "$current_pp"
			else
				printf 'agent:    pinentry-program=%s\n' "$wrapper"
			fi
		else
			printf 'agent:    <%s missing — run `pinentry-switch init`>\n' "$gnupg_conf"
		fi
		;;
	init)
		shift
		init_gpg_agent_conf "$@"
		;;
	*)
		validate_backend "$cmd" || exit 1
		mkdir -p -- "${mode_file%/*}"
		printf '%s\n' "$cmd" > "$mode_file"
		echo "pinentry-switch: backend set to '$cmd'"
		echo "  written: $mode_file"
		echo "  next pinentry invocation will use /usr/bin/pinentry-$cmd"
		;;
esac
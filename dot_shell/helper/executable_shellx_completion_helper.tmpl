#!/usr/bin/env python3
# shellx_completion_helper — tiny stdlib helper for zsh completion.
# Reads the shellx index and prints tags, var names, and process names
# (newline-separated, one per line).
#
# Usage:
#   shellx_completion_helper tags          # all tags
#   shellx_completion_helper processes     # all process names
#   shellx_completion_helper vars          # all variable names
#
# Exits silently (rc 0) if the store is not initialized.

import hashlib
import json
import os
import sys

# Mirrors executable_shellx's slug derivation: blake2b(STATIC_PW)[:16].hex().
# STATIC_PW is injected by chezmoi at apply time as
#   sha256sum("com.ardju.utils:shellx:" + nonce)
# — same derivation as the main shellx script. Keeping the helper
# self-contained (no shellx import) avoids a Python-level cycle.

SHELLX_STATIC_PW = "{{- printf "%s%s" "com.ardju.utils:shellx:" .system_environment.nonce | sha256sum -}}"


def _derived_slug() -> str:
    return hashlib.blake2b(SHELLX_STATIC_PW.encode(), digest_size=16).hexdigest()


def main():
    if len(sys.argv) < 2:
        sys.exit(0)
    kind = sys.argv[1]
    store = os.path.join(os.path.expanduser("~/.local/share"), _derived_slug())
    if not os.path.isdir(store):
        sys.exit(0)
    idx_path = os.path.join(store, ".idx")
    if not os.path.exists(idx_path):
        sys.exit(0)

    tags, procs, vars_ = set(), set(), set()
    with open(idx_path, "r") as f:
        for line in f:
            line = line.rstrip("\n")
            if not line or line.startswith("#"):
                continue
            parts = line.split("\t")
            if len(parts) < 3:
                continue
            var, tag_str, proc_str = parts[0], parts[1], parts[2]
            vars_.add(var)
            for t in tag_str.split(","):
                if t:
                    tags.add(t)
            for p in proc_str.split(","):
                if p:
                    procs.add(p)

    if kind == "tags":
        for t in sorted(tags):
            print(t)
    elif kind == "processes":
        for p in sorted(procs):
            print(p)
    elif kind == "vars":
        for v in sorted(vars_):
            print(v)


if __name__ == "__main__":
    try:
        main()
    except Exception:
        sys.exit(0)
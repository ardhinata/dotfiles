#!/usr/bin/env python3
# shellx_completion_helper — tiny stdlib helper for zsh completion.
# Reads the shellx index and prints tags, var names, and process names
# (newline-separated, one per line).
#
# Usage:
#   shellx_completion_helper tags          # all tags
#   shellx_completion_helper processes     # all process names
#   shellx_completion_helper vars          # all variable names
#
# Exits silently (rc 0) if the store is not initialized.

import hashlib
import json
import os
import subprocess
import sys

# Mirror executable_shellx's slug derivation: blake2b(STATIC_PW)[:16].hex().
# STATIC_PW is "chezmoi:shellx:<profile>:<nonce>", read from `chezmoi data`.
# We re-read chezmoi data here (instead of importing shellx) to keep this
# helper script self-contained and avoid a Python-level import cycle.


def _derived_slug() -> str:
    proc = subprocess.run(
        ["chezmoi", "data", "--format", "json"],
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        sys.exit(0)
    try:
        data = json.loads(proc.stdout)
    except json.JSONDecodeError:
        sys.exit(0)
    env = (data.get("system_environment") or {})
    profile = str(env.get("profile") or "").strip()
    nonce = str(env.get("nonce") or "").strip()
    if not profile or not nonce:
        sys.exit(0)
    static_pw = f"chezmoi:shellx:{profile}:{nonce}".encode()
    return hashlib.blake2b(static_pw, digest_size=16).hexdigest()


def main():
    if len(sys.argv) < 2:
        sys.exit(0)
    kind = sys.argv[1]
    store = os.path.join(os.path.expanduser("~/.local/share"), _derived_slug())
    if not os.path.isdir(store):
        sys.exit(0)
    idx_path = os.path.join(store, ".idx")
# ~/.shell/.zshenv
# Sourced by ~/.zshenv, so every zsh reads it: login, interactive and
# non-interactive. Keep it small and silent.
#
# This file is managed by chezmoi and holds no secret. The values come from
# the shellx store, which lives outside the repo.

[ -r "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
{{- template "section.tmpl" (dict "root" . "file" "dot_shell/dot_zshenv.tmpl" "section" "shellx-secrets") }}



# Jira and Bitbucket. Loaded on the work laptop only: the other hosts have no
# such store entry. One shellx call covers all four variables, so a shell pays
# for one decryption instead of four. xtrace is off across the eval, so
# `zsh -x` cannot print a value.
if [ -x "$HOME/.shell/helper/shellx" ]; then
	_shellx_xtrace=
	case $- in *x*) _shellx_xtrace=1; set +x ;; esac
	if _shellx_env="$("$HOME/.shell/helper/shellx" env \
		JIRA_URL JIRA_EMAIL JIRA_API_TOKEN BITBUCKET_API_TOKEN)"; then
		eval "$_shellx_env"
	else
		printf 'shellx: warning: failed to load the Jira and Bitbucket secrets\n' >&2
	fi
	if [ -n "$_shellx_xtrace" ]; then set -x; fi
	unset _shellx_env _shellx_xtrace
fi